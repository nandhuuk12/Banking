{
	"info": {
		"_postman_id": "banking-system-api",
		"name": "Banking System API",
		"description": "Complete API collection for Banking System with NetBanking operations",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{jwt_token}}",
				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8080/api",
			"type": "string"
		},
		{
			"key": "jwt_token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Login - Regular User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    pm.collectionVariables.set('jwt_token', response.accessToken);",
									"    pm.test('Login successful', function () {",
									"        pm.expect(response.accessToken).to.not.be.empty;",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"user1@bank.com\",\n    \"password\": \"User@123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"login"
							]
						}
					}
				},
				{
					"name": "Login - Admin User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@bank.com\",\n    \"password\": \"Admin@123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"login"
							]
						}
					}
				},
				{
					"name": "Refresh Token",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/auth/refresh",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"refresh"
							]
						}
					}
				}
			]
		},
		{
			"name": "Account Management",
			"item": [
				{
					"name": "Get User Accounts",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/accounts",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"accounts"
							]
						}
					}
				},
				{
					"name": "Get Account Summary",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/accounts/summary",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"accounts",
								"summary"
							]
						}
					}
				},
				{
					"name": "Create New Account",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"accountType\": \"SAVINGS\",\n    \"branchIfsc\": \"BANK0001234\",\n    \"initialDeposit\": 1000.00\n}"
						},
						"url": {
							"raw": "{{base_url}}/accounts",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"accounts"
							]
						}
					}
				},
				{
					"name": "Deposit Money",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"amount\": 500.00,\n    \"narration\": \"Cash deposit\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/accounts/123401000000001/deposit",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"accounts",
								"123401000000001",
								"deposit"
							]
						}
					}
				},
				{
					"name": "Withdraw Money",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"amount\": 200.00,\n    \"narration\": \"ATM withdrawal\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/accounts/123401000000001/withdraw",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"accounts",
								"123401000000001",
								"withdraw"
							]
						}
					}
				},
				{
					"name": "Transfer Money",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"fromAccountNumber\": \"123401000000001\",\n    \"toAccountNumber\": \"567801000000001\",\n    \"amount\": 100.00,\n    \"narration\": \"Transfer to friend\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/accounts/transfer",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"accounts",
								"transfer"
							]
						}
					}
				},
				{
					"name": "Get Account Balance",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/accounts/123401000000001/balance",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"accounts",
								"123401000000001",
								"balance"
							]
						}
					}
				}
			]
		},
		{
			"name": "Health Check",
			"item": [
				{
					"name": "Health Check",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/actuator/health",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"actuator",
								"health"
							]
						}
					}
				}
			]
		}
	]
}
